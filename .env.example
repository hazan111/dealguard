# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
# Gemini models are served from the global endpoint on this project (verified: us-central1 404s)
GEMINI_LOCATION=global

# Gemini
GEMINI_MODEL=gemini-3.5-flash

# Google Drive (data room)
DRIVE_DATA_ROOM_FOLDER_ID=
DRIVE_WATCH_CHANNEL_TOKEN=
DRIVE_SERVICE_ACCOUNT_KEY_PATH=

# Firestore (dedicated named database, not the project default)
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE=dealguard

# Agent Engine (resource names, filled in after each agent is deployed)
ORCHESTRATOR_AGENT_ENGINE_ID=
LEGAL_AGENT_ENGINE_ID=
FINANCIAL_AGENT_ENGINE_ID=
HR_AGENT_ENGINE_ID=
IP_AGENT_ENGINE_ID=

# Model Armor
MODEL_ARMOR_TEMPLATE_ID=dealguard-screen

# Dashboard auth
JWT_SECRET=
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_PASSWORD_HASH=

# Text-to-Speech (daily voice briefing)
TTS_VOICE_NAME=en-US-Neural2-D

# Schedule of Exceptions Google Doc (created on first draft-exception call)
SCHEDULE_OF_EXCEPTIONS_DOC_ID=

# Shared-secret between drive-watcher and gateway (fail-closed)
SERVICE_TOKEN=

# Display name written into the audit record for the signed-in reviewer
DASHBOARD_ADMIN_DISPLAY_NAME=Maya Chen
